OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Qdrant Cloud vector database. For local Docker, use http://localhost:6333 and leave API key blank.
QDRANT_URL=https://your-cluster-url.region.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION=notebooklm_documents

# Defaults are cost-friendly and work well for this assignment.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4.1-mini

PORT=3000
